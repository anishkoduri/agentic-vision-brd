  "shots": [
    {
      "id": "hook",
      "kind": "card",
      "say": "Ten Angus cows. Two days. Three cameras. One thousand seven hundred forty-nine clips."
    },
    {
      "id": "pipeline",
      "kind": "app",
      "say": "We built a vision pipeline that watches the pen around the clock, detects what each cow is doing, and looks for the early signs of respiratory disease.",
      "do": [
        {
          "goto": "/docs/visualization.html"
        },
        {
          "wait": 500
        },
        {
          "cut": true
        },
        {
          "focus": {
            "sel": "section:nth-of-type(2)",
            "pad": 200,
            "max": 1.6,
            "ms": 1200
          }
        },
        {
          "wait": 4600
        },
        {
          "focus": null
        },
        {
          "scroll": {
            "to": 1100,
            "ms": 1000
          }
        },
        {
          "focus": {
            "sel": "section:nth-of-type(4) svg",
            "pad": 120,
            "max": 1.7,
            "ms": 1000
          }
        }
      ]
    },
    {
      "id": "found",
      "kind": "app",
      "say": "Here's what it found.",
      "do": [
        {
          "hover": "section:nth-of-type(4) svg"
        }
      ]
    },
    {
      "id": "drop",
      "kind": "app",
      "say": "On day two, feeding fell sharply at midday — at one PM, from twenty-seven percent to under one percent — while lying time rose.",
      "do": [
        {
          "focus": null
        },
        {
          "scroll": {
            "to": "bottom",
            "ms": 900
          }
        },
        {
          "focus": {
            "sel": "section:nth-of-type(5) svg",
            "pad": 110,
            "max": 1.7,
            "ms": 900
          }
        },
        {
          "wait": 2600
        },
        {
          "hover": "section:nth-of-type(5) svg rect[x=\"360.8\"]"
        },
        {
          "focus": {
            "sel": "section:nth-of-type(5) svg rect[x=\"360.8\"]",
            "pad": 230,
            "max": 1.7,
            "ms": 1100
          }
        }
      ]
    },
    {
      "id": "pattern",
      "kind": "app",
      "say": "Less eating, more lying. That's a pattern a veterinarian would investigate first.",
      "do": [
        {
          "focus": {
            "sel": "section:nth-of-type(4) table",
            "pad": 260,
            "max": 1.6,
            "ms": 1100
          }
        }
      ]
    },
    {
      "id": "honest",
      "kind": "app",
      "say": "We could not identify individual cows across clips, so we report the herd signal honestly instead of inventing a ranking.",
      "do": [
        {
          "focus": null
        },
        {
          "goto": {
            "to": "/challenge2-video/app/tracklets.html",
            "hard": true
          }
        },
        {
          "wait": 500
        },
        {
          "cut": true
        },
        {
          "focus": {
            "sel": "#tracklets",
            "pad": 70,
            "max": 1.5,
            "ms": 1000
          }
        },
        {
          "wait": 3200
        },
        {
          "focus": {
            "sel": "section.warn",
            "pad": 150,
            "max": 1.7,
            "ms": 1000
          }
        }
      ]
    },
    {
      "id": "arch",
      "kind": "card",
      "say": "All of it ran on a single laptop, no cloud."
    },
    {
      "id": "close",
      "kind": "card",
      "say": "The full evidence is in the technical brief and the repository."
